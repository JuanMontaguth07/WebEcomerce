# Copia este archivo como .env.local y completa los valores.
# En Vercel, define las mismas variables en Project Settings → Environment Variables.

# URL pública del sitio, sin barra final (local: http://localhost:3000).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Usa la "publishable key" (sb_publishable_...). Es pública por diseño: la
# seguridad la dan las políticas RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# NUNCA agregues aquí la "secret key" / service_role con prefijo NEXT_PUBLIC_.
# La aplicación no la necesita.
